# --- Credenciales (obligatorias la primera vez) ---
PASITO_EMAIL=tu-email@ejemplo.com
PASITO_PASSWORD=tu-password

# --- Opcional ---
# TZ=America/Argentina/Buenos_Aires
# DAILY_CAP_OVERRIDE=0        # 0 = leer el tope de las feature flags del servidor
# PATTERN=sessions           # sessions | commute (ida y vuelta al trabajo) | ramp
# COMMUTE_OUT=09:00          # salida (sólo PATTERN=commute)
# COMMUTE_BACK=15:00         # regreso
# COMMUTE_MINUTES=60         # duración mínima de cada tramo
# COMMUTE_FROM=-38.00550,-57.54260   # Plaza San Martín, Mar del Plata
# COMMUTE_TO=-38.03350,-57.52150     # Puerto, Mar del Plata
# DAILY_FRACTION_MIN=0.97    # objetivo diario como fracción del tope
# DAILY_FRACTION_MAX=1.0
# WINDOW_START=07:30
# WINDOW_END=21:30
# MAX_BURST_STEPS=1500
# TICK_SECONDS=600
# DRY_RUN=0
# LOG_LEVEL=INFO
